{
  "name": "sansa-published-mirror",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "verify:assets": "node tools/apply-patches.mjs --check",
    "patch": "node tools/apply-patches.mjs --apply",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "localize": "node tools/generate-localization.mjs",
    "format": "prettier --write 'server/**/*.mjs' 'tools/**/*.mjs' 'tests/**/*.mjs' 'locales/**/*.mjs' 'locales/*.json' package.json .prettierrc.json",
    "format:check": "prettier --check 'server/**/*.mjs' 'tools/**/*.mjs' 'tests/**/*.mjs' 'locales/**/*.mjs' 'locales/*.json' package.json .prettierrc.json",
    "check": "npm run format:check && npm run verify:assets && npm test"
  },
  "dependencies": {
    "ws": "8.22.2"
  },
  "devDependencies": {
    "playwright-core": "1.62.0",
    "prettier": "3.9.10"
  }
}
